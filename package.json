{
  "name": "pi-jetbrains-junie-bridge",
  "version": "1.5.0",
  "description": "Pi extension that connects Pi coding agent with JetBrains Junie as the AI backend",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi",
    "pi-package",
    "junie",
    "jetbrains",
    "coding-agent",
    "ai"
  ],
  "author": "Sven Schatter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jawi-xmedicus/pi-jetbrains-junie-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Jawi-xmedicus/pi-jetbrains-junie-bridge/issues"
  },
  "homepage": "https://github.com/Jawi-xmedicus/pi-jetbrains-junie-bridge#readme",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.ts",
    "lib/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
